# No shebang: this jailbreak's AMFI blocks execve of shebang scripts. dpkg
# invokes maintainer scripts through its shell.

HOSTD=/var/jb/usr/macOS/bin/macwshostd
HOSTD_PLIST=/var/jb/Library/LaunchDaemons/com.macwsguide.hostd.plist
HOST_APP=/var/jb/Applications/MacWSHost.app/MacWSHost
KEYCHAIND=/var/jb/usr/macOS/bin/macwskeychaind
