<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.apple.coreservices.sharedfilelistd</string>
	<key>MachServices</key>
	<dict>
		<key>com.apple.coreservices.sharedfilelistd.xpc</key>
		<true/>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/var/jb/usr/macOS/bin/launchdchrootexec</string>
		<string>501</string>
		<string>501</string>
		<string>/var/mnt/rootfs</string>
		<string>/System/Library/CoreServices/sharedfilelistd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- The MacWS desktop currently runs as uid 0. Ventura's root user
		     record names /var/root, while Finder persists the canonical
		     /private/var/root spelling. CoreServicesInternal otherwise first
		     resolves every favorite relative to /var/root, rejects that
		     candidate because its path string is non-canonical, marks the
		     bookmark stale, and rewrites it forever. Keep the service's own
		     CoreFoundation home identity canonical; this changes neither the
		     account database nor the bookmark validation result. -->
		<key>CFFIXED_USER_HOME</key>
		<string>/private/var/root</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/var/jb/var/mobile/sharedfilelistd.out</string>
	<key>StandardErrorPath</key>
	<string>/var/jb/var/mobile/sharedfilelistd.err</string>
</dict>
</plist>
